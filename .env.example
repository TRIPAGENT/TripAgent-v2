# TripAgent app. Copy to .env.local (git-ignored) and fill in.
# Vite ships every VITE_ variable to the browser, so nothing secret goes here.
# Server-side keys (Tripsure, the model, the desk password) live only in the
# agent's own .env and in the agent host's environment settings.

# --- local development ---
# Where the agent is, for the dev and preview proxy. Defaults to 127.0.0.1:3000.
AGENT_ORIGIN=http://127.0.0.1:3000
# Where the sourcing engine lives, for `npm run catalogue`.
SOURCING_ENGINE=/Users/polaris/Downloads/VSC-Codes-Polaris/tripagent-sourcing-engine
AGENT_ROOT=/Users/polaris/Downloads/VSC-Codes-Polaris/Chatbot_v1/tripagent

# --- production (set these in Vercel → Project → Settings → Environment Variables) ---
# The agent's public https address, e.g. https://agent.tripagent.vip
# Leave empty locally: the app then uses its own /agent proxy.
VITE_AGENT_URL=

# Browser key for Google Maps (the city map). It is public by design, so it
# MUST be restricted in Google Cloud → Credentials → HTTP referrers to
# localhost:5173, localhost:4173 and your production domain.
VITE_GOOGLE_MAPS_API_KEY=

# The desk's WhatsApp Business number, digits only with country code (e.g.
# 919800000000). Empty hides the WhatsApp button rather than linking nowhere.
VITE_WHATSAPP_NUMBER=

# Where the image library is served from if it moves off Vercel. Empty uses public/img.
VITE_IMAGE_CDN_BASE=

# --- the person who answers ---
# A member paying this much is owed a name, a city and a number. Fill these in
# and the door, the membership card and the Desk screen all show them. Leave
# them empty and the app speaks as "the Desk" rather than inventing a person.
VITE_ADVISOR_NAME=
VITE_ADVISOR_ROLE=Your travel advisor
VITE_ADVISOR_CITY=Bengaluru
VITE_ADVISOR_PHONE=
# Cities this advisor has actually travelled, comma separated. Shown as evidence
# behind a recommendation. Leave empty until it is true.
VITE_ADVISOR_TRAVELLED=
